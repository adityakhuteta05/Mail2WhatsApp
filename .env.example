# Application
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-32-byte-hex-or-fernet-compatible-secret-key-12345
LOG_LEVEL=INFO

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google Cloud Pub/Sub
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project-id/topics/gmail-events
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
PUBSUB_VERIFICATION_TOKEN=optional-pubsub-verification-token

# Database
# Use SQLite for local development or PostgreSQL for production / Supabase:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mail2whatsapp
DATABASE_URL=sqlite:///./mail2whatsapp.db

# WhatsApp Business Platform / Cloud API
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token
WHATSAPP_RECIPIENT_NUMBER=1234567890
WHATSAPP_API_VERSION=v21.0

# Email Processing Options
RETAIN_EMAIL_BODIES=true
MAX_ATTACHMENT_SIZE_MB=25
RECONCILIATION_INTERVAL_HOURS=24
WATCH_RENEWAL_WINDOW_HOURS=24
